# Configuratie aplicatie - copiati acest fisier ca .env si completati valorile reale
# Acest fisier este safe de pus in Git (nu contine secrete reale)

DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/auto_recommender

# Generati cu: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace_with_secure_random_string

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Rate limit pe /api/auth/login (format slowapi: "N/period")
LOGIN_RATE_LIMIT=5/minute

# Origini permise pentru CORS (frontend-ul)
CORS_ORIGINS=http://localhost:5173
